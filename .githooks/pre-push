#!/usr/bin/env bash
# pre-push: check formatting and lint before code leaves this machine.
# Runs swiftformat --lint (no rewrite) and swiftlint on the whole tree.
# Periphery is intentionally excluded — it requires a full build and is
# too slow for a push gate. Run `make lint` / `scripts/lint.sh` on demand.
set -euo pipefail

export PATH="$PATH:/opt/homebrew/bin"

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail_if_missing() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "pre-push: $1 not on PATH. Install via Homebrew: brew install $2" >&2
    exit 1
  fi
}

fail_if_missing swiftformat swiftformat
fail_if_missing swiftlint swiftlint

echo "pre-push: swiftformat --lint ."
swiftformat . --lint

echo "pre-push: swiftlint"
swiftlint

echo "pre-push: ok"
